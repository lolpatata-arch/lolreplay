#!/usr/bin/env python3
"""Public command for the GUI and existing recorder."""
import os
import sys
from pathlib import Path
bin_dir = Path(__file__).absolute().parent
args = sys.argv[1:]
if not args or args == ['ui']:
    target = bin_dir / 'lolreplay-ui'
    args = []
elif args == ['--version']:
    print('lolreplay 2.6.0')
    sys.exit(0)
elif args[0] == 'update':
    target = bin_dir / 'lolreplay_updater.py'
    args = args[1:]
    os.execv(sys.executable, [sys.executable, str(target), *args])
else:
    target = bin_dir / 'crimson-clips'
try:
    os.execv(str(target), [str(target), *args])
except OSError as exc:
    sys.exit(f'lolreplay: {exc}')
