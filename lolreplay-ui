        self.pending=args[0]; self.message.setText(t('Select your monitor in the sharing dialog…') if args[0]=='start' and compositor.capture(read_json(CONFIG))=='portal' else 'Running '+ ' '.join(args)+'…'); self.paint_status(); self.action.start(str(CLI),list(args)); self.action_watch.start(180000 if args[0] in ('save','start') else 30000)

