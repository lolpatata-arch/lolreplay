    def foreground(self):
        return self.isVisible() and QApplication.instance().applicationState()==Qt.ApplicationState.ApplicationActive and not self.isMinimized()

    def application_state_changed(self,state):
        if self.closing: return
        if self.prefs['pause_in_background'] and not self.foreground():
            if self.player: self.player.pause()
            self.editor.pause()
        if self.isVisible() and (self.foreground() or self.prefs['background_refresh']):
            self.health_timer.stop(); self.timer.start(); self.tick(); self.next_thumbnail()
        else:
            self.timer.stop(); self.health_timer.start()
            if not self.isVisible(): self.editor.stop_strip()

    def showEvent(self,event):
        super().showEvent(event)
        if hasattr(self,'health_timer'): self.application_state_changed(QApplication.instance().applicationState())
        if getattr(self,'_responsive_ready',False): self.update_layout(force=True)

    def background_health(self):
        if not self.closing and (self.last_confirmed_active or self.isVisible() or self.tray.isVisible()): self.check_status()

    def changeEvent(self,event):
        super().changeEvent(event)
        if hasattr(self,'timer') and event.type()==QEvent.Type.WindowStateChange:
            self.application_state_changed(QApplication.instance().applicationState())

    def tick(self):
        if not self.isVisible() or (not self.foreground() and not self.prefs['background_refresh']) or self.closing: return
        if self.pending is None:
            now=time.monotonic()
            if now-getattr(self,'last_config_sync',-100)>10:
                self.sync_config(); self.last_config_sync=now
        self.check_status(); self.refresh_library(); self.next_thumbnail()

    def check_status(self):
        if self.pending is None and self.poll.state()==QProcess.ProcessState.NotRunning:
            if not CLI.is_file(): self.active=None; self.paint_status(); return
            self.poll.start(str(CLI),['status']); self.poll_watch.start(5000)

    def status_done(self,code,exit_status):
        self.poll_watch.stop()
        if self.pending is not None: return
        current=(code==0) if exit_status==QProcess.ExitStatus.NormalExit and code in (0,1) else None
        if current is False and self.last_confirmed_active:
            self.recorder_interrupted=True; self.message.setText(t('Replay ended unexpectedly. Restart to begin a new buffer.')); self.tray_notice(t('Replay ended unexpectedly. Restart to begin a new buffer.'))
        if current is not None: self.last_confirmed_active=current
        if current is True: self.recorder_interrupted=False
        self.active=current; self.paint_status()
        err=bytes(self.poll.readAllStandardError()).decode(errors='replace').strip(); self.poll.readAllStandardOutput()
        if self.active is None and err: self.message.setText(err)

    def status_error(self,error):
        if error==QProcess.ProcessError.FailedToStart: self.poll_watch.stop(); self.active=None; self.paint_status()

