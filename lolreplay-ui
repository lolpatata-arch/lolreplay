        if not p: return
        if QMessageBox.question(self,t('Move to trash'),t('Move {0} to the system trash?',p.name))!=QMessageBox.StandardButton.Yes: return
        if not self.release_clip(p): return
        from PySide6.QtCore import QFile
        try:
            f=QFile(str(p)); result=f.moveToTrash()
            ok=result[0] if isinstance(result,tuple) else result
            self.message.setText(t('Moved to trash.') if ok else t('Trash unavailable; nothing permanently deleted.'))
        except (OSError,AttributeError,TypeError) as e: self.message.setText('Trash unavailable: '+str(e))
        self.refresh_library(force=True)

