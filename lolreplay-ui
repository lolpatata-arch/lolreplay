    def foreground(self):
        return QApplication.instance().applicationState()==Qt.ApplicationState.ApplicationActive and not self.isMinimized()

    def application_state_changed(self,state):
        if self.closing: return
        if self.prefs['pause_in_background'] and not self.foreground():
            if self.player: self.player.pause()
            self.editor.pause()
        if self.foreground() or self.prefs['background_refresh']:
            self.timer.start(); self.tick(); self.next_thumbnail()
        else:
            self.timer.stop()

    def changeEvent(self,event):
        super().changeEvent(event)
        if hasattr(self,'timer') and event.type()==QEvent.Type.WindowStateChange:
            self.application_state_changed(QApplication.instance().applicationState())

    def tick(self):
        if (not self.foreground() and not self.prefs['background_refresh']) or self.closing: return
        if self.pending is None: self.sync_config()
        self.check_status(); self.refresh_library(); self.next_thumbnail()

    def check_status(self):
        if self.pending is None and self.poll.state()==QProcess.ProcessState.NotRunning:
            if not CLI.is_file(): self.active=None; self.paint_status(); return
            self.poll.start(str(CLI),['status']); self.poll_watch.start(5000)

    def status_done(self,code,exit_status):
        self.poll_watch.stop()
        if self.pending is not None: return
        self.active=(code==0) if exit_status==QProcess.ExitStatus.NormalExit and code in (0,1) else None; self.paint_status()
        err=bytes(self.poll.readAllStandardError()).decode(errors='replace').strip(); self.poll.readAllStandardOutput()
        if self.active is None and err: self.message.setText(err)

    def status_error(self,error):
        if error==QProcess.ProcessError.FailedToStart: self.poll_watch.stop(); self.active=None; self.paint_status()

    def paint_status(self):
        if not hasattr(self,'start_btn'): return
        title={True:t('Replay active'),False:t('Replay stopped'),None:t('Recorder unavailable')}[self.active]; self.hero_status.setText(title)
        self.state.setText({True:t('Replay active'),False:t('Standby'),None:t('Unavailable')}[self.active]); self.state.setStyleSheet('color:'+('#73d9aa' if self.active else '#a6a6b2')); self.state_dot.setStyleSheet('border-radius:4px;background:'+('#73d9aa' if self.active else '#777780')+';')
        idle=self.pending is None; valid=getattr(self,'config_valid',True)
        self.stop_btn.setEnabled(idle and self.active is True)
        idle=idle and valid
        self.start_btn.setEnabled(idle and self.active is False); self.save_btn.setEnabled(idle and self.active is True); self.lengths.setEnabled(idle)
        for (secs,_),b in zip(DURATIONS,self.duration_buttons): b.setEnabled(idle and secs<=self.buffer_seconds)
        for b in (self.folder_btn,self.drive_btn,self.mic_btn,self.source_btn,self.output_btn,self.profile_btn,self.buffer_btn,self.rate_btn): b.setEnabled(idle and self.active is False and not self.editor.busy())
        if hasattr(self,"niri_mode_btn"): self.niri_mode_btn.setEnabled(idle and self.active is False)
        self.sync_duration_ui()

    def choose_duration(self,seconds):
        if seconds==self.duration:
            self.sync_duration_ui()
        elif 2<=seconds<=self.buffer_seconds:
            self.run('duration',str(seconds))

