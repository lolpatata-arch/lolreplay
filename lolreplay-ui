def run_desktop():
    app=QApplication.instance()
    runtime=Path(os.environ.get('XDG_RUNTIME_DIR',f'/run/user/{os.getuid()}'))
    if not runtime.is_dir():
        window=Window(); window.show(); return app.exec()
    socket_name=str(runtime/'lolreplay-ui.sock')
    lock=QLockFile(str(runtime/'lolreplay-ui.lock')); lock.setStaleLockTime(0)
    if not lock.tryLock(0):
        client=QLocalSocket(); client.connectToServer(socket_name)
        if client.waitForConnected(1000):
            client.disconnectFromServer(); return 0
        print('lolreplay interface already running or starting',file=sys.stderr); return 1
    server=QLocalServer(); QLocalServer.removeServer(socket_name)
    if not server.listen(socket_name):
        lock.unlock(); return 1
    window=Window()
    def reopen():
        while server.hasPendingConnections():
            client=server.nextPendingConnection()
            if client: client.disconnectFromServer(); client.deleteLater()
        if not window.closing: window.restore_window()
    server.newConnection.connect(reopen); window.show()
    try: return app.exec()
    finally: server.close(); lock.unlock()


