        if self.pending is not None: return
        menu=QMenu(self.lengths)
        menu.setMinimumWidth(self.lengths.width())
        choices={}
        for secs,name in DURATIONS:
            act=menu.addAction(t(name)); act.setCheckable(True); act.setChecked(secs==self.duration)
            act.setEnabled(secs<=self.buffer_seconds)
            choices[act]=secs
        menu.addSeparator()
        custom=menu.addAction(t('Custom duration…')); custom.setCheckable(True); custom.setChecked(self.duration not in dict(DURATIONS))
        selected=menu.exec(self.lengths.mapToGlobal(self.lengths.rect().bottomLeft()))
        if selected is None: return
