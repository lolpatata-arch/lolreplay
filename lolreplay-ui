    def apply_theme(self):
        bg,panelbg,border,accent,bright=THEMES[self.theme]
        # Own the palette even for native-looking controls and transient dialogs.
        app=QApplication.instance()
        pal=QPalette()
        colors={
            'Window':bg, 'Base':panelbg, 'AlternateBase':bg, 'Button':panelbg,
            'WindowText':'#f4f4f7', 'Text':'#f4f4f7', 'ButtonText':'#f4f4f7',
            'Light':border, 'Midlight':border, 'Mid':border, 'Dark':bg, 'Shadow':bg,
            'Highlight':accent, 'HighlightedText':'#111111' if QColor(accent).lightness()>150 else '#ffffff',
            'ToolTipBase':panelbg, 'ToolTipText':'#e1e1e6', 'PlaceholderText':'#8c8c93',
            'Link':bright, 'LinkVisited':bright,
        }
        for role, color in colors.items():
            pal.setColor(QPalette.ColorRole[role],QColor(color))
        for role in ('WindowText','Text','ButtonText','PlaceholderText'):
            pal.setColor(QPalette.ColorGroup.Disabled,QPalette.ColorRole[role],QColor('#74747e'))
        if hasattr(QPalette.ColorRole,'Accent'):
            pal.setColor(QPalette.ColorRole.Accent,QColor(accent))
        app.setPalette(pal)
        contrast='#111111' if QColor(accent).lightness()>150 else '#ffffff'
        focus='#626269' if self.theme=='AMOLED' else accent
        hover='#55555c' if self.theme=='AMOLED' else accent
        stylesheet=f'''QWidget {{background:{bg};color:#f4f4f7;font-family:"Inter","Noto Sans",sans-serif;font-size:13px;}}
