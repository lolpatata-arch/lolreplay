class ClipDelegate(QStyledItemDelegate):
    """Media tile: artwork, title, timestamp and file size, without Qt's default icon chrome."""
    def __init__(self, window, view):
        super().__init__(view); self.window=window
    def sizeHint(self, option, index):
        return self.parent().gridSize()
    def paint(self, painter, option, index):
        painter.save(); painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        r=option.rect.adjusted(5,5,-5,-5)
        bg,panel,border,accent,bright=THEMES[self.window.theme]
        selected=bool(option.state & QStyle.StateFlag.State_Selected)
        hovered=bool(option.state & QStyle.StateFlag.State_MouseOver)
        painter.setPen(QPen(QColor(bright),1.4) if selected else Qt.PenStyle.NoPen)
        painter.setBrush(QColor(panel if hovered or selected else bg)); painter.drawRoundedRect(QRectF(r),6,6)
        a=QRect(r.x()+3,r.y()+3,r.width()-6,int((r.width()-6)*9/16))
        path=QPainterPath(); path.addRoundedRect(QRectF(a),4,4)
        painter.save(); painter.setClipPath(path); painter.fillRect(a,QColor('#09090b'))
        pix=index.data(Qt.ItemDataRole.DecorationRole)
        if isinstance(pix,QIcon):
            image=pix.pixmap(QSize(a.width(),a.height()))
            if not image.isNull():
                if image.width()>32:
                    image=image.scaled(a.size(),Qt.AspectRatioMode.KeepAspectRatioByExpanding,Qt.TransformationMode.SmoothTransformation)
                painter.drawPixmap(a.x()+(a.width()-image.width())//2,a.y()+(a.height()-image.height())//2,image)
        painter.restore()
        painter.setPen(QColor('#f2f0f3')); f=QFont(option.font); f.setPixelSize(round(13*self.window.prefs['text_scale']/100)); f.setWeight(QFont.Weight.DemiBold); painter.setFont(f)
        parts=str(index.data(Qt.ItemDataRole.DisplayRole) or '').split('\n',1)
        title=painter.fontMetrics().elidedText(parts[0],Qt.TextElideMode.ElideRight,r.width()-22)
        painter.drawText(QRect(r.x()+11,a.bottom()+8,r.width()-22,round(19*self.window.prefs['text_scale']/100)),Qt.AlignmentFlag.AlignLeft|Qt.AlignmentFlag.AlignVCenter,title)
        f.setPixelSize(round(11*self.window.prefs['text_scale']/100)); f.setWeight(QFont.Weight.Normal); painter.setFont(f); painter.setPen(QColor('#eeeeee' if self.window.prefs['high_contrast'] else '#a3a1aa'))
        meta=parts[1] if len(parts)>1 else ''; meta=painter.fontMetrics().elidedText(meta,Qt.TextElideMode.ElideRight,r.width()-22)
        painter.drawText(QRect(r.x()+11,a.bottom()+round(29*self.window.prefs['text_scale']/100),r.width()-22,round(17*self.window.prefs['text_scale']/100)),Qt.AlignmentFlag.AlignLeft|Qt.AlignmentFlag.AlignVCenter,meta)
        painter.restore()

class Artwork(QWidget):
    def __init__(self, window):
        super().__init__(); self.window=window; self.pix=None; self.setMinimumHeight(185); self.setSizePolicy(QSizePolicy.Policy.Expanding,QSizePolicy.Policy.Expanding)
    def set_art(self,pix):
        self.pix=pix; self.update()
    def mouseReleaseEvent(self,event):
        if event.button()==Qt.MouseButton.LeftButton and self.rect().contains(event.position().toPoint()) and self.window.snapshot:
            self.window.open_latest(); event.accept(); return
        super().mouseReleaseEvent(event)
    def paintEvent(self,event):
        p=QPainter(self); p.setRenderHint(QPainter.RenderHint.Antialiasing); p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        r=self.rect(); clip=QPainterPath(); clip.addRoundedRect(QRectF(r),10,10); p.setClipPath(clip)
        bg,panel,border,accent,bright=THEMES[self.window.theme]
        if self.pix is not None and not self.pix.isNull():
            im=self.pix.scaled(r.size(),Qt.AspectRatioMode.KeepAspectRatioByExpanding,Qt.TransformationMode.SmoothTransformation)
            p.drawPixmap((r.width()-im.width())//2,(r.height()-im.height())//2,im)
        else:
            w=r.width(); h=r.height()
            # A static, theme-aware recording instrument, not a decorative animation.
            grad=QLinearGradient(0,0,w,h); grad.setColorAt(0,QColor(bg).lighter(112)); grad.setColorAt(1,QColor(panel)); p.fillRect(r,QBrush(grad))
            cx=int(w*.75); cy=int(h*.48); radius=max(25,min(int(w*.16),int(h*.28)))
            glow=QRadialGradient(cx,cy,max(1,radius*2.35)); tint=QColor(accent); tint.setAlpha(76); glow.setColorAt(0,tint); tint.setAlpha(0); glow.setColorAt(1,tint); p.fillRect(r,QBrush(glow))
            p.setBrush(Qt.BrushStyle.NoBrush)
            for scale in (1.14,1.42,1.70):
                d=radius*scale; line=QColor(bright); line.setAlpha(43); p.setPen(QPen(line,1)); p.drawEllipse(QRectF(cx-d,cy-d,d*2,d*2))
            for i in range(48):
                a=i*math.tau/48; outer=radius*1.7; inner=outer-(8 if i%4==0 else 3)
                line=QColor(bright); line.setAlpha(120 if i%4==0 else 50); p.setPen(QPen(line,1)); p.drawLine(int(cx+inner*math.cos(a)),int(cy+inner*math.sin(a)),int(cx+outer*math.cos(a)),int(cy+outer*math.sin(a)))
            p.setPen(QPen(QColor(accent),2.5)); d=radius*1.42; p.drawArc(QRectF(cx-d,cy-d,d*2,d*2),30*16,100*16)
            size=int(radius*2.05); im=self.window.logo.pixmap(QSize(size,size)); p.drawPixmap(cx-im.width()//2,cy-im.height()//2,im)
            x=24; tw=max(1,int(w*.54)-x); active=self.window.active
            f=QFont(self.font()); f.setPixelSize(11); f.setWeight(QFont.Weight.DemiBold); p.setFont(f)
            status_color=QColor('#73d9aa' if active is True else bright); p.setPen(Qt.PenStyle.NoPen); p.setBrush(status_color); p.drawEllipse(QRectF(x,26,7,7)); p.setPen(status_color)
            p.drawText(QRect(x+14,19,max(1,tw-14),22),Qt.AlignmentFlag.AlignVCenter,t('BUFFER ACTIVE') if active is True else (t('STANDBY') if active is False else t('CHECKING RECORDER')))
            f.setPixelSize(32 if w>=630 else 23 if w>=400 else 17); f.setWeight(QFont.Weight.Bold); p.setFont(f); p.setPen(QColor('#f4f4f7'))
            title=t('Catch the\nmoment.') if active is True else t('Ready when\nyou are.')
            p.drawText(QRect(x,42,tw,max(20,h-78)),Qt.AlignmentFlag.AlignVCenter.value|Qt.AlignmentFlag.AlignLeft.value|Qt.TextFlag.TextWordWrap.value,title)
            f.setPixelSize(11); f.setWeight(QFont.Weight.Normal); p.setFont(f); p.setPen(QColor('#b5b5bf'))
            hint=(t('Save {0}',self.window.format_duration_label(self.window.duration))+' · '+(self.window.global_key or '—')) if active is True else t('Start replay to capture.')
            p.drawText(QRect(x,h-32,tw,24),Qt.AlignmentFlag.AlignVCenter,p.fontMetrics().elidedText(hint,Qt.TextElideMode.ElideRight,tw))
        p.end()

class ReplayWindow(QWidget):
    """Display the configured save window within the configured history; not measured fill."""
    def __init__(self,window):
        super().__init__(); self.window=window; self.setFixedHeight(22)
        self.setToolTip('Selected clip length relative to configured history, not actual buffer fill.')
        self.setAccessibleName('Selected clip length relative to history')
    def paintEvent(self,event):
        p=QPainter(self); p.setRenderHint(QPainter.RenderHint.Antialiasing)
        bg,surface,border,accent,bright=THEMES[self.window.theme]
        ratio=min(1,max(0,self.window.duration/max(1,self.window.buffer_seconds)))
        n=32; step=self.width()/n; selected=max(1,math.ceil(n*ratio))
        p.setPen(Qt.PenStyle.NoPen)
        for i in range(n):
            p.setBrush(QColor(accent if i>=n-selected else border)); p.drawRoundedRect(QRectF(i*step,3,max(1,step-2),16),1.5,1.5)
        p.end()

