    def folder_dialog(self,initial,drive=None):
        dialog=QFileDialog(self,t('Choose clip folder'),str(initial))
        dialog.setOption(QFileDialog.Option.DontUseNativeDialog,True)
        dialog.setFileMode(QFileDialog.FileMode.Directory)
        dialog.setOption(QFileDialog.Option.ShowDirsOnly,True)
        urls=[QUrl.fromLocalFile(str(HOME)),QUrl.fromLocalFile(str(HOME/'Videos'))]
        try:
            for d in drives.discover():
                urls.extend(QUrl.fromLocalFile(m) for m in d['mounts'] if Path(m).is_dir())
        except Exception: pass  # Manual path selection still works without lsblk.
        dialog.setSidebarUrls(urls)
        if not dialog.exec() or not dialog.selectedFiles(): return
        if self.active is not False or self.pending or self.editor.busy(): return
        path=dialog.selectedFiles()[0]
        try:
            if drive is not None: path=str(drives.folder_on_drive(drive,path))
        except Exception as exc:
            self.message.setText(str(exc)); return
        self.run('directory',path)

    def choose_drive(self):
        if self.active is not False or self.pending or self.editor.busy(): return
        try: items=drives.discover()
        except Exception as exc:
            self.message.setText('Cannot enumerate drives: '+str(exc)); return
        if not items:
            QMessageBox.information(self,t('Detected drives'),t('No supported data filesystems found. Connect your drive and open this list again. You can still use Change folder for manually mounted paths.')); return
        choices=[drives.describe(d) for d in items]
        choice,ok=QInputDialog.getItem(self,t('Detected drives'),t('Select a drive (list refreshed every time):'),choices,0,False)
        if not ok or self.active is not False or self.pending or self.editor.busy(): return
        try: d=drives.current(items[choices.index(choice)])
        except Exception as exc: self.message.setText(str(exc)); return
        if d['mounts']:
            self.select_drive_folder(d); return
        if not shutil.which('udisksctl'):
            self.message.setText(t('udisksctl is missing. Install udisks2 or mount the drive in Dolphin.')); return
        if QMessageBox.question(self,t('Mount drive'),t('Mount {0} ({1}) using the system storage service?',d['label'],d['device']))!=QMessageBox.StandardButton.Yes: return
        if self.active is not False or self.pending or self.editor.busy(): return
        try: d=drives.current(d)
        except Exception as exc: self.message.setText(str(exc)); return
        if d['mounts']: self.select_drive_folder(d); return
        self.mount_target=d; self.pending='mount-drive'; self.message.setText('Mounting '+d['device']+'…'); self.paint_status()
        self.action.start('udisksctl',['mount','--block-device',d['device'],'--no-user-interaction']); self.action_watch.start(30000)

    def select_drive_folder(self,d):
        if self.active is not False or self.pending or self.editor.busy(): return
        try: d=drives.current(d)
        except Exception as exc: self.message.setText(str(exc)); return
        if not d['mounts']:
            self.message.setText(t('No mount path available. Open Detected drives again after mounting.')); return
        root=next((m for m in d['mounts'] if os.access(m,os.W_OK|os.X_OK)),d['mounts'][0])
        self.folder_dialog(root,d)

