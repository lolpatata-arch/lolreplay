    def release_clip(self,p):
        if self.editor.busy():
            self.message.setText(t('Finish or cancel the export first.')); return False
        try: storage.config_check(p.parent)
        except OSError as exc: self.message.setText(str(exc)); return False
        if self.editor.source==p.resolve(): self.editor.release()
        if self.player and self.preview_path==str(p):
            self.player.stop(); self.player.setSource(QUrl()); self.preview_path=None
        return True

    def rename_selected(self):
        p=self.selected_path()
        if not p: return
        name,ok=QInputDialog.getText(self,t('Rename clip'),t('New name (without extension):'),text=p.stem)
        if not ok: return
        name=name.strip()
        if not name or name.startswith('.') or '/' in name or chr(0) in name:
            self.message.setText(t('Invalid clip name')); return
        target=p.with_name(name+p.suffix)
        if target==p: return
        if not self.release_clip(p): return
        try:
            # Same filesystem, no overwrite. Do not delete the old link until new one exists.
            os.link(p,target)
            try: p.unlink()
            except OSError:
                target.unlink(); raise
            self.message.setText(t('Renamed: ')+target.name)
        except OSError as e: self.message.setText('Rename: '+str(e))
        self.refresh_library(force=True)

