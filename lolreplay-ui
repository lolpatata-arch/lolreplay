    def set_preference(self,key,value):
        previous=self.prefs.copy(); self.prefs=prefs.validated({**self.prefs,key:value})
        try: write_ui(prefs.merge_ui(read_json(UI_CONFIG),self.prefs))
        except OSError as exc:
            self.prefs=previous; self.sync_pref_controls(); self.message.setText(str(exc)); return
        self.apply_preferences()

    def sync_pref_controls(self):
        for key,w in self.pref_controls.items():
            old=w.blockSignals(True)
            if isinstance(w,QCheckBox): w.setChecked(self.prefs[key])
            else: w.setCurrentIndex(w.findData(self.prefs[key]))
            w.blockSignals(old)

    def reset_preferences(self):
        previous=self.prefs; self.prefs=prefs.DEFAULTS.copy()
        try: write_ui(prefs.merge_ui(read_json(UI_CONFIG),self.prefs))
        except OSError as exc: self.prefs=previous; self.message.setText(str(exc)); return
        self.sync_pref_controls(); self.apply_preferences()

